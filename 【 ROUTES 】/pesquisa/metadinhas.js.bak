// api/endpoints/metadinhas.js
import express from 'express';
import { getRandomMetadinha, getAllMetadinhas } from '../../【 SCRAPERS 】/services/metadinhaService.js';

const router = express.Router();

// Metadinha aleatória
router.get('/', (req, res, next) => {
  try {
    res.json([getRandomMetadinha()]);
  } catch (err) {
    next(err);
  }
});

// Todas as metadinhas
router.get('/all', (req, res, next) => {
  try {
    res.json(getAllMetadinhas());
  } catch (err) {
    next(err);
  }
});

export default router;