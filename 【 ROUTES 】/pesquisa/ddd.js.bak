import express from 'express';
const router = express.Router();

import { buscarCidade, listarCidadesPorDDD, infoGeral } from '../../【 SCRAPERS 】/dddService.js';
import { extractAcronymFromCity } from '../../utils/estados.js';

router.get('/', (req, res, next) => {
  const { query, ddd, limit = 20 } = req.query;

  try {
    if (query) {
      const resultado = buscarCidade(query);
      if (!resultado.encontrada) return res.status(404).json({ error: resultado.mensagem });

      const sigla = extractAcronymFromCity(resultado.estado);
      return res.json({
        sucesso: true,
        tipo: 'busca',
        ...resultado,
        mensagem: `✅ *${resultado.cidade}* (DDD ${resultado.ddd} - ${sigla})`
      });
    }

    if (ddd) {
      const resultado = listarCidadesPorDDD(ddd, parseInt(limit));
      if (resultado.error) return res.status(400).json({ error: resultado.error });
      return res.json(resultado);
    }

    res.json({ sucesso: true, info: infoGeral() });
  } catch (err) {
    next(err);
  }
});

export default router;