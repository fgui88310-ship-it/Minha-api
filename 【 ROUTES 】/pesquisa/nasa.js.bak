import express from 'express';
import { getApod } from '../../【 SCRAPERS 】/nasa.service.js';

const router = express.Router();

router.get('/', async (req, res, next) => {
  try {
    const { date } = req.query;

    if (!date) {
      return res.status(400).json({ error: 'Passe ?date=YYYY-MM-DD' });
    }

    const result = await getApod(date);

    if (!result) {
      return res.status(404).json({ error: 'Não foi possível obter a APOD da NASA.' });
    }

    res.json(result);

  } catch (err) {
    next(err);
  }
});

export default router;