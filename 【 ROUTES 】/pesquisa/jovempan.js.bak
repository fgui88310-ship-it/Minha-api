import express from 'express';
import { buscarNoticiasJovemPan } from '../../services/jovemPanService.js';
import { buscarNoticiasPoder360 } from '../../services/poder360Service.js';

const router = express.Router();

/**
 * Endpoint unificado: /api/noticias?fonte=jovempan ou poder360
 */
router.get('/', async (req, res, next) => {
  const { fonte = 'jovempan' } = req.query;

  try {
    let noticias = [];
    let tituloFonte = '';

    if (fonte === 'jovempan') {
      noticias = await buscarNoticiasJovemPan();
      tituloFonte = 'Jovem Pan';
    } else if (fonte === 'poder360') {
      noticias = await buscarNoticiasPoder360();
      tituloFonte = 'Poder360';
    } else {
      return res.status(400).json({ error: 'Fonte inválida. Use ?fonte=jovempan ou ?fonte=poder360' });
    }

    if (!noticias.length)
      return res.status(404).json({ error: `Nenhuma notícia encontrada em ${tituloFonte}` });

    let msg = `📰 *Notícias recentes da ${tituloFonte}*\n\n`;
    noticias.forEach((n, i) => {
      msg += `*${i + 1}. ${n.titulo}*\n`;
      msg += `📌 *Categoria:* ${n.categoria}\n`;
      if (n.imagem) msg += `🖼️ *Imagem:* ${n.imagem}\n`;
      if (n.descricao) msg += `📝 ${n.descricao}\n`;
      msg += `🔗 [Leia Mais](${n.link})\n\n`;
    });

    res.json({
      fonte: tituloFonte,
      total: noticias.length,
      noticias,
      mensagem_formatada: msg,
    });
  } catch (err) {
    next(err);
  }
});

export default router;