import express from 'express';
import { getFilmesEmCartaz } from '../services/cinemaService.js';

const router = express.Router();

/**
 * Endpoint: /api/cinema
 * Retorna lista de filmes em cartaz do AdoroCinema
 */
router.get('/', async (req, res, next) => {
  try {
    const filmes = await getFilmesEmCartaz();

    if (!filmes.length) {
      return res.status(404).json({ error: 'Nenhum filme válido encontrado.' });
    }

    res.json(filmes);
  } catch (err) {
    next(err);
  }
});

export default router;