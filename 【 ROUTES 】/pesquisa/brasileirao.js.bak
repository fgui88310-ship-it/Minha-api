import express from 'express';
import { fetchTabelaBrasileirao } from '../../【 SCRAPERS 】/brasileiraoService.js';
import { formatTabela } from '../../【 UTILS 】/formatTabela.js';

const router = express.Router();

router.get('/', async (req, res, next) => {
  const { limit = 20 } = req.query; // removido 'serie'

  try {
    const data = await fetchTabelaBrasileirao(); // sem parâmetro
    const tabela = formatTabela(data, Number(limit));

    res.json({
      serie: 'A', // fixo, já que a API só retorna Série A
      atualizado_em: new Date().toLocaleString('pt-BR'),
      total_times: data.length,
      tabela,
    });
  } catch (err) {
    console.error('Erro na API Bronxys:', err.message);
    res.status(500).json({ 
      error: 'Erro ao buscar tabela do Brasileirão', 
      detalhes: err.message 
    });
  }
});

export default router;