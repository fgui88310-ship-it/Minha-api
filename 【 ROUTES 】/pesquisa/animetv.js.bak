import express from 'express';
import { fetchAnimeData, parseJsonFromScripts, parseHtmlFallback } from '../../services/animetvService.js';

const router = express.Router();

router.get('/', async (req, res, next) => {
  const { query, limit = 5 } = req.query;
  if (!query) return res.status(400).json({ error: 'Passe ?query= para buscar animes' });

  try {
    const html = await fetchAnimeData(query);

    let animes = parseJsonFromScripts(html, limit);
    if (animes.length === 0) {
      animes = parseHtmlFallback(html, limit);
    }

    if (animes.length === 0) {
      return res.status(404).json({ error: 'Nenhum anime encontrado. Tente usar um navegador headless.' });
    }

    res.json(animes);
  } catch (err) {
    console.error('Erro na requisição:', err.message);
    next(err);
  }
});

export default router;