import express from 'express';
import { searchGoogleImages } from '../scrapers/googleImageScraper.js';

const router = express.Router();

router.get('/', async (req, res, next) => {
  const { query, limit = 20 } = req.query;
  if (!query) return res.status(400).json({ error: 'Passe ?query= para pesquisar' });

  try {
    const images = await searchGoogleImages(query, parseInt(limit));

    if (!images.length)
      return res.status(404).json({ error: `Nenhuma imagem encontrada para "${query}"` });

    res.json({
      total: images.length,
      query,
      limit: parseInt(limit),
      resultados: images
    });
  } catch (err) {
    console.error('[GIMAGE ENDPOINT] Erro:', err.message);
    next(err);
  }
});

export default router;