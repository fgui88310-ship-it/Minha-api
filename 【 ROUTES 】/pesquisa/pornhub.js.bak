import express from 'express';
import PornhubService from '../../services/pornhubService.js';

const router = express.Router();

router.get('/', async (req, res, next) => {
  try {
    const { query, limit = 5, tipo = 'video', page = 1 } = req.query;
    if (!query) return res.status(400).json({ error: 'Passe ?query=' });

    let resultados = [];

    if (tipo === 'video') resultados = await PornhubService.getVideos(query, limit, page);
    else if (tipo === 'gif') resultados = await PornhubService.getGifs(query, limit, page);
    else return res.status(400).json({ error: 'Tipo inválido (video|gif)' });

    if (resultados.length === 0)
      return res.status(404).json({ error: 'Nenhum resultado encontrado' });

    res.json(resultados);

  } catch (err) {
    next(err);
  }
});

export default router;