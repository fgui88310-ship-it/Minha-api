import express from 'express';
import { buscarNoticiasGlobo } from '../scrapers/globoScraper.js';

const router = express.Router();

router.get('/', async (req, res, next) => {
  try {
    const { limit = 3 } = req.query;
    const noticias = await buscarNoticiasGlobo(parseInt(limit));

    if (!noticias.length)
      return res.status(404).json({ error: 'Nenhuma notícia encontrada' });

    let mensagem = '📰 *Notícias recentes da Globo*\n\n';
    noticias.forEach((n, i) => {
      mensagem += `*${i + 1}. ${n.titulo}*\n`;
      if (n.descricao) mensagem += `📝 ${n.descricao}\n`;
      mensagem += `🔗 [Leia Mais](${n.link})\n\n`;
    });

    res.json({
      total: noticias.length,
      noticias,
      mensagem_formatada: mensagem,
    });
  } catch (err) {
    next(err);
  }
});

export default router;