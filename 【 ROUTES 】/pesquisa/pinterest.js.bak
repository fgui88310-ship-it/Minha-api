import express from 'express';
import { buscarImagensPinterest } from '../../services/pinterest.service.js';

const router = express.Router();

router.get('/', async (req, res, next) => {
  const { query } = req.query;

  if (!query) {
    return res.status(400).json({
      error: 'Passe ?query= para pesquisar'
    });
  }

  try {
    const result = await buscarImagensPinterest(query);

    if (!result) {
      return res.status(404).json({ error: 'Nenhuma imagem encontrada.' });
    }

    res.json(result);
  } catch (err) {
    next(err);
  }
});

export default router;