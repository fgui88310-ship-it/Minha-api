import express from 'express';
import { buscarNoticiasIGN } from '../../scrapers/ignScraper.js';

const router = express.Router();

router.get('/', async (req, res, next) => {
  try {
    const { query = '', limit = 10, site = 'ign' } = req.query;

    if (site !== 'ign') {
      return res.status(400).json({ error: 'Apenas o site IGN é suportado no momento.' });
    }

    const noticias = await buscarNoticiasIGN({ query, limit });
    if (!noticias.length) {
      return res.status(404).json({ error: `Nenhuma notícia encontrada para "${query}"` });
    }

    console.log(`✅ ${noticias.length} notícias retornadas.`);
    res.json(noticias);
  } catch (err) {
    console.error('❌ Erro no endpoint /game-news:', err.message);
    next(err);
  }
});

export default router;