import express from 'express';
import ReceitaService from '../../services/receitaService.js';

const router = express.Router();

router.get('/', async (req, res, next) => {
  try {
    const { q } = req.query;
    if (!q) return res.status(400).json({ error: 'Passe ?q=termo da receita' });

    const receitas = await ReceitaService.searchReceitas(q);

    if (!receitas.length)
      return res.status(404).json({ error: `Nenhuma receita encontrada para "${q}"` });

    res.json({ query: q, total: receitas.length, receitas });

  } catch (err) {
    next(err);
  }
});

export default router;