import express from 'express';
import { buscarFilmes } from '../services/imdbService.js';

const router = express.Router();

/**
 * Endpoint: /api/imdb?query=nome-do-filme&limit=5
 */
router.get('/', async (req, res, next) => {
  const { query, limit = 5 } = req.query;
  if (!query) {
    return res.status(400).json({ error: 'Passe ?query= com o nome do filme.' });
  }

  try {
    const filmes = await buscarFilmes(query, parseInt(limit));
    if (!filmes.length) {
      return res.status(404).json({ error: 'Nenhum resultado encontrado.' });
    }

    res.json({ query, total: filmes.length, filmes });
  } catch (err) {
    console.error('[IMDB] Erro:', err.message);
    next(err);
  }
});

export default router;