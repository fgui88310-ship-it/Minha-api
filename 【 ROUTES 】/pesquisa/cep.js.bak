import express from 'express';
import { buscarCep } from '../【 SCRAPERS 】/cepService.js';
import { formatCepData } from '../【 UTILS 】/formatCepData.js';

const router = express.Router();

router.get('/', async (req, res, next) => {
  const { cep } = req.query;
  if (!cep) {
    return res.status(400).json({ error: 'Passe ?cep= para buscar o endereço.' });
  }

  try {
    const data = await buscarCep(cep);
    res.json(formatCepData(data));
  } catch (err) {
    if (err.message.includes('CEP não encontrado')) {
      res.status(404).json({ error: '❌ CEP não encontrado.' });
    } else {
      next(err);
    }
  }
});

export default router;