import express from 'express';
import { obterDetalhesFilme } from '../../services/imdbDetalhesService.js';

const router = express.Router();

/**
 * Endpoint: /api/imdb/detalhes?url=https://www.imdb.com/title/tt4154796/
 */
router.get('/', async (req, res, next) => {
  const { url } = req.query;

  if (!url || !url.includes('imdb.com')) {
    return res.status(400).json({
      error: 'Forneça o link completo do filme. Exemplo: ?url=https://www.imdb.com/title/tt4154796/',
    });
  }

  try {
    const detalhes = await obterDetalhesFilme(url);
    res.json(detalhes);
  } catch (err) {
    console.error('[IMDB DETALHES] Erro:', err.message);
    next(err);
  }
});

export default router;