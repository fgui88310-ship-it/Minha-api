// api/endpoints/wikipedia.js
import express from "express";
import { buscarWikipedia } from "../services/wikipediaService.js";

const router = express.Router();

router.get("/", async (req, res, next) => {
  const { query, limit = 1 } = req.query;

  if (!query) {
    return res
      .status(400)
      .json({ error: "Passe ?query= para buscar na Wikipedia" });
  }

  try {
    const resultados = await buscarWikipedia(query, parseInt(limit));

    if (!resultados || resultados.length === 0) {
      return res.status(404).json({ error: "Nenhum resultado encontrado" });
    }

    res.json(resultados);
  } catch (err) {
    next(err);
  }
});

export default router;