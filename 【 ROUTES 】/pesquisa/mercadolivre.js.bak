import express from 'express';
import { buscarProdutosML } from '../services/mercadoLivreService.js';

const router = express.Router();

router.get('/', async (req, res, next) => {
  try {
    const { query, limit = 8 } = req.query;
    if (!query) return res.status(400).json({ error: 'Passe ?query= para buscar produtos' });

    const produtos = await buscarProdutosML(query, limit);

    if (!produtos.length) {
      return res.status(404).json({ error: 'Nenhum produto encontrado.' });
    }

    res.json(produtos);
  } catch (err) {
    next(err);
  }
});

export default router;