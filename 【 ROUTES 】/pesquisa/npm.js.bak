import express from 'express';
import { buscarPacotes } from '../services/npmService.js';

const router = express.Router();

router.get('/', async (req, res, next) => {
  const { query, limit } = req.query;

  if (!query) return res.status(400).json({ error: 'Passe ?query= para buscar pacotes npm' });

  try {
    const pacotes = await buscarPacotes(query, limit);
    if (pacotes.length === 0) {
      return res.status(404).json({ error: 'Nenhum pacote encontrado' });
    }
    res.json(pacotes);
  } catch (err) {
    next(err);
  }
});

export default router;