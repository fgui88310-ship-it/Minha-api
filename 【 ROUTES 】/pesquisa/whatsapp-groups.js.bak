// api/endpoints/grupos.js
import express from "express";
import { buscarGrupos } from "../services/gruposService.js";

const router = express.Router();

router.get("/", async (req, res, next) => {
  const { query, limit = 5 } = req.query;

  if (!query) {
    return res
      .status(400)
      .json({ error: "Passe ?query= para buscar grupos." });
  }

  try {
    const grupos = await buscarGrupos(query, parseInt(limit));

    if (!grupos || grupos.length === 0) {
      return res.status(404).json({ error: "Nenhum grupo encontrado." });
    }

    res.json(grupos);
  } catch (err) {
    next(err);
  }
});

export default router;