import express from 'express';
import { buscarAppAptoide } from '../【 SCRAPERS 】/aptoideService.js';
import { gerarLinkCurto } from '../【 UTILS 】/shortLink.js';

const router = express.Router();

/**
 * Endpoint: /api/aptoide?query=WhatsApp
 * Retorna nome, versão, tamanho e link de download do app
 */
router.get('/', async (req, res, next) => {
  const { query } = req.query;

  if (!query) {
    return res.status(400).json({ error: 'Passe ?query= para buscar o app.' });
  }

  try {
    const app = await buscarAppAptoide(query);
    const shortLink = await gerarLinkCurto(app.linkOriginal);

    res.json({
      nome: app.nome,
      pacote: app.pacote,
      versão: app.versão,
      tamanhoMB: app.tamanhoMB,
      imagem: app.imagem,
      download: shortLink,
    });
  } catch (err) {
    res.status(500).json({ error: err.message });
  }
});

export default router;