import express from 'express';
import PrintsiteService from '../../【 SCRAPERS 】/printsiteService.js';
import { isValidUrl } from '../../【 UTILS 】/validateUrl.js';

const router = express.Router();

router.get('/', async (req, res, next) => {
  try {
    const { url } = req.query;

    if (!url)
      return res.status(400).json({ error: 'Passe ?url= para capturar o screenshot' });

    if (!isValidUrl(url))
      return res.status(400).json({ error: 'URL inválido. Forneça https://example.com' });

    const result = await PrintsiteService.captureScreenshot(url);

    if (result.error)
      return res.status(404).json({ error: result.error });

    res.set('Content-Type', result.contentType);
    res.send(result.data);

  } catch (err) {
    next(err);
  }
});

export default router;