import express from 'express';
import { buscarNoticias } from '../../【 SCRAPERS 】/noticias.service.js';

const router = express.Router();

/**
 * GET /api/noticias?query=tema&limit=1
 */
router.get('/', async (req, res, next) => {
  const { query, limit = 1 } = req.query;

  if (!query) return res.status(400).json({
    error: 'Informe um tema para pesquisar notícias! Passe ?query=tema'
  });

  try {
    const noticias = await buscarNoticias(query, Number(limit));

    if (!noticias.length) {
      return res.status(404).json({ error: 'Nenhuma notícia encontrada para este tema' });
    }

    res.json({
      totalEncontrados: noticias.length,
      noticias
    });
  } catch (err) {
    next(err);
  }
});

export default router;