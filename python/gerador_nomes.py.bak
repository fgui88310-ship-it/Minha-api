import numpy as np
import pickle
import sys
import json

WEIGHTS_FILE = os.path.join(os.path.dirname(__file__), 'pesos_nomes.pkl')

# ====================== CARREGAR MODELO ======================
with open(WEIGHTS_FILE, 'rb') as f:
    data = pickle.load(f)

Wxh = data['Wxh']
Whh = data['Whh']
Why = data['Why']
bh  = data['bh']
by  = data['by']

chars = data['chars']
char_to_ix = data['char_to_ix']
ix_to_char = data['ix_to_char']

hidden_size = data['hidden_size']
vocab_size  = data['vocab_size']

# ====================== GERAR NOME ======================
def gerar_nome(temperature=1.0, max_length=30):
    h = np.zeros((hidden_size, 1))
    seed_ix = char_to_ix.get('\n', 0)

    x = np.zeros((vocab_size, 1))
    x[seed_ix] = 1

    nome = []

    for _ in range(max_length):
        h = np.tanh(Wxh @ x + Whh @ h + bh)
        y = Why @ h + by

        y /= temperature
        p = np.exp(y - np.max(y))
        p /= p.sum()

        ix = np.random.choice(vocab_size, p=p.ravel())
        char = ix_to_char[ix]

        if char == '\n' and len(nome) >= 3:
            break

        nome.append(char)
        x = np.zeros((vocab_size, 1))
        x[ix] = 1

    return ''.join(nome).capitalize()

# ====================== CLI ======================
if __name__ == '__main__':
    args = json.loads(sys.argv[1]) if len(sys.argv) > 1 else {}
    quantidade = args.get('quantidade', 1)
    temperature = args.get('temperature', 1.0)

    nomes = [gerar_nome(temperature) for _ in range(quantidade)]
    print(json.dumps({'nomes': nomes}))